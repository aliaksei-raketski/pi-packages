{
  "name": "@aliaksei-raketski/pi-packages",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "nx": "nx",
    "prepare": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit || true",
    "format:staged": "node tools/scripts/format-staged.mjs",
    "check": "nx sync:check && nx format:check --all && pnpm run check:workflows && pnpm run check:docs && nx run-many -t lint,typecheck --parallel=3 && pnpm run check:package-artifacts",
    "check:workflows": "node tools/scripts/check-workflow-policy.mjs",
    "check:docs": "node tools/scripts/check-documentation.mjs",
    "test": "nx run-many -t test --parallel=3",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "build:packages": "nx run-many -t build --projects=packages/* --parallel=3",
    "verify:package-artifacts": "node tools/scripts/verify-package-artifacts.mjs",
    "check:package-artifacts": "pnpm run build:packages && pnpm run verify:package-artifacts",
    "release": "pnpm run check:package-artifacts && nx release --skip-publish",
    "release:dry-run": "pnpm run check:package-artifacts && nx release --skip-publish --dry-run",
    "publish": "pnpm run check:package-artifacts && nx release publish",
    "release:publish:dry-run": "pnpm run check:package-artifacts && nx release publish --dry-run"
  },
  "private": true,
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@eslint/js": "catalog:",
    "@nx/eslint": "catalog:",
    "@nx/eslint-plugin": "catalog:",
    "@nx/js": "catalog:",
    "@nx/plugin": "catalog:",
    "@nx/vitest": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/helpers": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "jsdom": "catalog:",
    "jsonc-eslint-parser": "catalog:",
    "nx": "catalog:",
    "prettier": "catalog:",
    "tslib": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@nx/devkit": "catalog:"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b"
}
